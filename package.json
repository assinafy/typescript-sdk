{
    "name": "@assinafy/sdk",
    "version": "2.1.0",
    "packageManager": "bun@1.3.14",
    "description": "TypeScript SDK for Assinafy API - Digital signature platform",
    "type": "commonjs",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts --clean",
        "test": "bun test",
        "test:coverage": "bun test --coverage",
        "lint": "eslint src scripts --max-warnings=0",
        "lint:fix": "eslint src scripts --fix",
        "lint:pkg": "publint --strict && attw --pack .",
        "audit": "bun audit",
        "audit:api": "bun scripts/api-contract-audit.ts",
        "prepack": "bun run build",
        "prepublishOnly": "bun run verify && bun run audit",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.tests.json",
        "verify": "bun run typecheck && bun run lint && bun run test:coverage && bun run build && bun run lint:pkg"
    },
    "keywords": [
        "assinafy",
        "assinafy-api",
        "assinatura-eletronica",
        "assinatura-digital",
        "assinatura",
        "digital-signature",
        "electronic-signature",
        "signature",
        "pdf",
        "webhook",
        "sdk",
        "api-client",
        "typescript",
        "brazil"
    ],
    "author": "Assinafy API Team",
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/assinafy/typescript-sdk.git"
    },
    "bugs": {
        "url": "https://github.com/assinafy/typescript-sdk/issues"
    },
    "homepage": "https://github.com/assinafy/typescript-sdk/#readme",
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@eslint/js": "^10.0.1",
        "@types/bun": "^1.3.14",
        "@types/node": "^22.20.1",
        "eslint": "^10.8.0",
        "publint": "^0.3.23",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.66.0"
    },
    "dependencies": {
        "axios": "^1.19.0"
    },
    "overrides": {
        "esbuild": "0.28.1",
        "brace-expansion": "5.0.9"
    },
    "files": [
        "dist",
        "docs",
        "README.md",
        "CHANGELOG.md",
        "SECURITY.md",
        "LICENSE"
    ]
}
