{
    "name": "@assinafy/sdk",
    "version": "2.0.0",
    "description": "TypeScript SDK for Assinafy API - Digital signature platform",
    "type": "commonjs",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts --clean",
        "test": "bun test",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "lint:pkg": "publint --strict && attw --pack .",
        "prepublishOnly": "bun run build",
        "release": "bun run typecheck && bun run lint && bun test && bun run build && npm publish --access public && npm publish --registry=https://npm.pkg.github.com",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "assinafy",
        "assinafy-api",
        "assinatura-eletronica",
        "assinatura-digital",
        "assinatura",
        "digital-signature",
        "electronic-signature",
        "signature",
        "pdf",
        "webhook",
        "sdk",
        "api-client",
        "typescript",
        "brazil"
    ],
    "author": "Assinafy API Team",
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/assinafy/typescript-sdk.git"
    },
    "bugs": {
        "url": "https://github.com/assinafy/typescript-sdk/issues"
    },
    "homepage": "https://github.com/assinafy/typescript-sdk/#readme",
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@eslint/js": "^9.0.0",
        "@types/bun": "^1.3.0",
        "@types/node": "^26.1.1",
        "eslint": "^9.0.0",
        "publint": "^0.3.21",
        "tsup": "^8.0.0",
        "typescript": "^5.0.0",
        "typescript-eslint": "^8.0.0"
    },
    "dependencies": {
        "axios": "^1.6.0"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ]
}
