{
    "// note": "Typechecks the Bun unit tests with the same strict options as the shipped source without emitting declarations.",
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "declaration": false,
        "declarationMap": false,
        "noEmit": true,
        "types": ["node", "bun"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
